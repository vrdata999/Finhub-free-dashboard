# Copy this file to ".env" and fill in your own keys.
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)
#
# .env is gitignored — your real keys never get committed.

# Finnhub free-tier API key: https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_key_here

# OpenRouter key for the dashboard's AI Analysis tab (optional).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenRouter model. Free-tier models work on a $0 account but 429 at peak;
# the client auto-falls back through a list of :free models if this one fails.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free